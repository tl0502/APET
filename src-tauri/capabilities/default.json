{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "默认能力集 — pet / settings / chat / tasks / pomodoro / workspace 窗口可使用核心 IPC（事件 listen/emit、窗口操作等）+ 全局快捷键 + 拖动 + 头像/人格文件选择与保存 + 番茄独立窗 fullscreen/AOT 切换（#28 follow-up）+ workspace 主窗（#35 ADR-021 P1）+ workspace 自绘 chrome min/max 按钮（#37 ADR-021 P3）。",
  "windows": ["pet", "settings", "chat", "tasks", "pomodoro", "workspace", "pet-reminder", "pet-command"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-always-on-top",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-outer-position",
    "core:window:allow-current-monitor",
    "core:window:allow-available-monitors",
    "core:window:allow-primary-monitor",
    "global-shortcut:allow-is-registered",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "dialog:allow-open",
    "dialog:allow-save",
    "notification:default"
  ]
}
