{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI 桌宠",
  "version": "0.0.0",
  "identifier": "com.aipet.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "pet",
        "title": "AI 桌宠",
        "url": "index.html",
        "width": 320,
        "height": 320,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "center": true
      },
      {
        "label": "settings",
        "title": "设置 — AI 桌宠",
        "url": "settings.html",
        "width": 800,
        "height": 600,
        "minWidth": 640,
        "minHeight": 480,
        "transparent": false,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "resizable": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:aipet.db"]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
