{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI 桌宠",
  "version": "0.0.0",
  "identifier": "com.aipet.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "pet",
        "title": "AI 桌宠",
        "url": "index.html",
        "width": 320,
        "height": 320,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": false,
        "center": true
      },
      {
        "label": "chat",
        "title": "对话 — AI 桌宠",
        "url": "chat.html",
        "width": 640,
        "height": 480,
        "minWidth": 480,
        "minHeight": 400,
        "maxWidth": 1000,
        "maxHeight": 800,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": false,
        "visible": false,
        "center": true
      },
      {
        "label": "onboarding",
        "title": "灵魂宣誓 — AI 桌宠",
        "url": "onboarding.html",
        "width": 480,
        "height": 720,
        "transparent": false,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "resizable": false,
        "visible": false,
        "center": true
      },
      {
        "label": "pomodoro",
        "title": "番茄 — AI 桌宠",
        "url": "pomodoro.html",
        "width": 360,
        "height": 480,
        "transparent": false,
        "decorations": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "resizable": false,
        "visible": false,
        "center": true
      },
      {
        "label": "workspace",
        "title": "工作台 — AI 桌宠",
        "url": "workspace.html",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 520,
        "transparent": false,
        "decorations": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "resizable": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCONFIG/avatars/**"]
      }
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:aipet.db"]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": ["assets/onboarding/*", "assets/legal/*"]
  }
}
